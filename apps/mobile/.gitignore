# dependencies
node_modules/

# Vite build output (Capacitor's webDir — rebuilt via `npx cap sync` before each native build)
dist/

# Capacitor
.capacitor/

# Android — the android/ project itself is committed (Capacitor convention:
# native plugin config lives there and isn't fully regenerable), only its
# build/local-machine artifacts are ignored.
android/.gradle/
android/app/build/
android/build/
android/local.properties
android/.idea/
android/*.iml
android/app/release/

# Signing material — never commit
*.jks
*.keystore
*.p8
*.p12
*.mobileprovision

# macOS
.DS_Store

# local env files
.env
.env*.local

# typescript
*.tsbuildinfo
