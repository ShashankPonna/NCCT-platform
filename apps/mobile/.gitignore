# dependencies
node_modules/

# Vite build output (Capacitor's webDir — rebuilt via `npx cap sync` before each native build)
dist/

# Capacitor
.capacitor/

# Android — the android/ project itself is committed (Capacitor convention:
# native plugin config lives there and isn't fully regenerable), only its
# build/local-machine artifacts are ignored.
android/.gradle/
android/app/build/
android/build/
android/local.properties
android/.idea/
android/*.iml
android/app/release/

# iOS — same convention as Android above: the ios/ project itself is
# committed, only build/local-machine artifacts and CocoaPods' regenerable
# Pods/ directory are ignored. Podfile.lock IS committed (like a
# package-lock.json) for reproducible `pod install` — not ignored here.
ios/App/Pods/
ios/App/build/
ios/App/App.xcworkspace/xcuserdata/
ios/App/App.xcodeproj/xcuserdata/
ios/App/App.xcodeproj/project.xcworkspace/xcuserdata/

# Signing material — never commit
*.jks
*.keystore
*.p8
*.p12
*.mobileprovision

# macOS
.DS_Store

# local env files
.env
.env*.local

# typescript
*.tsbuildinfo
