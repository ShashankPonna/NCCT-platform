PORT=4000
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
PUBLIC_WEB_URL=http://localhost:5173
# Required for F7's chatbot answer generation (docs/DECISIONS.md #35, amends
# #25 — moved from Gemini to Groq). Embeddings run locally and need no key;
# only the generation call needs this. Get a key at https://console.groq.com.
GROQ_API_KEY=
# Required for F12's AI Career Counsellor tool-calling loop (docs/DECISIONS.md
# #27) — still Gemini, unchanged by #35, which only touched F7.
GEMINI_API_KEY=
# Required for self-hosted (non-YouTube) lesson video upload/playback via
# Backblaze B2 (docs/DECISIONS.md #20). Without these, video-type lessons
# with no video_id fall back to a 503 "Video storage unavailable" — every
# other route works fine without them. B2_ENDPOINT is the bucket's S3
# Endpoint shown on its page in the B2 dashboard (e.g.
# https://s3.us-west-004.backblazeb2.com) — copy it verbatim, don't
# construct it by hand. B2_KEY_ID/B2_APPLICATION_KEY come from an
# S3-compatible Application Key scoped to just this bucket, not your B2
# master key.
B2_ENDPOINT=
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
