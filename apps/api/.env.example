PORT=4000
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
PUBLIC_WEB_URL=http://localhost:5173
# The one AI key the platform needs (docs/DECISIONS.md #35, #68): F7's FAQ
# chatbot, F12's AI Career Counsellor and P1's skill-gap "what to learn
# first" ranking all call Groq. Embeddings run locally and need no key.
# Without it the chatbot/counsellor return a 503 "unavailable" and the
# ranking is simply omitted; everything else works. Get a key at
# https://console.groq.com. Server-side only — never put it in apps/web.
GROQ_API_KEY=
# Required for self-hosted (non-YouTube) lesson video upload/playback via
# Backblaze B2 (docs/DECISIONS.md #20). Without these, video-type lessons
# with no video_id fall back to a 503 "Video storage unavailable" — every
# other route works fine without them. B2_ENDPOINT is the bucket's S3
# Endpoint shown on its page in the B2 dashboard (e.g.
# https://s3.us-west-004.backblazeb2.com) — copy it verbatim, don't
# construct it by hand. B2_KEY_ID/B2_APPLICATION_KEY come from an
# S3-compatible Application Key scoped to just this bucket, not your B2
# master key.
B2_ENDPOINT=
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
# Optional (docs/DECISIONS.md #49). When set, GET /lessons/:id/video-url
# returns a stable, non-expiring URL under this domain instead of a
# short-lived signed B2 URL — needed for a CDN (e.g. Cloudflare proxying
# this domain at the B2 bucket) to actually cache video bytes across
# repeat views, since a URL that re-mints and re-expires on every request
# can never be cached. Leave unset to keep today's short-lived-signed-URL
# behavior unchanged — this is a deliberate security-posture change, not
# just a performance knob, so it's opt-in. Setup: point this domain at
# your B2 bucket's public S3 endpoint through Cloudflare (proxied/orange
# cloud), and make sure the bucket (or this path) allows public read —
# see DECISIONS.md #49 for the exact tradeoff before turning this on.
VIDEO_CDN_BASE_URL=
